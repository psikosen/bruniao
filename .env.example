# Bruniao Trading Bot Environment Variables
# Copy this file to .env and fill in your values

# Polymarket Authentication
# Your Ethereum private key (without 0x prefix)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# API credentials (obtained via L1/L2 auth flow)
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_passphrase

# LLM API Keys (for bot debates and analysis)
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key  # Optional, for embeddings

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# DragonflyDB - High-Performance Distributed Cache
# 25x faster than Redis, drop-in compatible
DRAGONFLY_URL=redis://localhost:6379

# RabbitMQ - Message Queue
# Password for RabbitMQ authentication
RABBITMQ_PASSWORD=bruniao_secret
RABBITMQ_URL=amqp://bruniao:bruniao_secret@localhost:5672/trading

# Worker Configuration
MAX_CONCURRENT_DEBATES=5
